{%- from "partials/icons.njk" import icon -%}
{%- macro copyButton(value, label) -%}
<button class="copy" type="button" data-copy="{{ value }}" data-done="{{ t.donate.copied }}" data-fail="{{ t.donate.copyFailed }}" aria-label="{{ t.donate.copy }}{{ t.sep }}{{ label }}">
  {{ icon("copy") }}<span data-label>{{ t.donate.copy }}</span>
</button>
{%- endmacro -%}
{#- Compact list of cards / wallets right under the hero; the SWIFT details fold out on request. -#}
<section class="section section--donate" id="donate" aria-labelledby="donate-title">
  <div class="wrap donate">
    <div class="donate__head">
      <p class="eyebrow">{{ t.donate.eyebrow }}</p>
      <h2 id="donate-title">{{ t.donate.title }}</h2>
      <p class="lead">{{ t.donate.intro }}</p>
      <p class="recipient">
        {{ t.donate.recipientLabel }}{{ t.sep }}<strong>{{ t.donate.recipientName }}</strong>
        <span class="recipient__relation">({% fill t.donate.recipientRelation %})</span>
      </p>
    </div>

    {#- Online card payment, the easiest option for donors abroad -#}
    {% if campaign.gofundme and not (campaign.gofundme | isTodo) %}
    <div class="pay-online">
      <div class="pay-online__text">
        <h3 class="pay-row__title">{{ t.donate.online.title }}</h3>
        <p class="pay-row__meta">{{ t.donate.online.text }}</p>
      </div>
      <a class="btn btn--gofundme" href="{{ campaign.gofundme }}" target="_blank" rel="noopener">{{ icon("heart") }} {{ t.donate.online.button }}</a>
    </div>
    {% endif %}

    <ul class="pay-list">
      {% for m in campaign.payments %}
      {%- if m.type != "swift" %}
      {%- set mt = t.donate.methods[m.id] %}
      <li class="pay-row" id="pay-{{ m.id }}">
        <span class="pay-row__currency">{{ m.currency }}</span>
        <div class="pay-row__info">
          <h3 class="pay-row__title">{{ mt.title }}</h3>
          <p class="pay-row__meta">
            {%- if m.bank is defined %}{% fill m.bank %}{% endif %}
            {%- if m.bank is defined and mt.hint %} · {% endif %}
            {{- mt.hint -}}
          </p>
        </div>
        <div class="pay-row__account">
          <span class="pay-row__number" aria-label="{{ t.donate.cardNumber if m.type == 'card' else (t.donate.account | replace(':', '') | replace('՝', '') if m.type == 'account' else t.donate.walletNumber) }}">
            {%- if m.type == "card" %}<span class="pay-row__emoji" aria-hidden="true">💳</span> {% endif -%}
            {%- if m.type == "account" %}<span class="pay-row__number-label">{{ t.donate.account }}</span> {% endif -%}
            {{ (m.number | groupDigits) if m.type == "card" else m.number }}
          </span>

          {#- A real button (keyboard + screen readers); only the [data-label] text changes on copy, so the icon stays -#}
          {% if m.accountNumber is defined %}
          <button class="pay-row__account_number" type="button"
            data-copy="{{ m.accountNumber }}"
            data-done="{{ t.donate.copied }}: {{ m.accountNumber }}"
            data-fail="{{ t.donate.copyFailed }}">
            {{ icon("copy") }}<span data-label>{{ t.donate.account }} {{ m.accountNumber }}</span>
          </button>
          {% endif %}

          {#- Account holder, when it differs from the main recipient (e.g. the rouble account) -#}
          {% if m.beneficiary is defined and not (m.beneficiary | isTodo) %}
          <button class="pay-row__account_number" type="button"
            data-copy="{{ m.beneficiary }}"
            data-done="{{ t.donate.copied }}: {{ m.beneficiary }}"
            data-fail="{{ t.donate.copyFailed }}">
            {{ icon("copy") }}<span data-label>{{ t.donate.beneficiary }} {{ m.beneficiary }}</span>
          </button>
          {% endif %}
        </div>
        {{ copyButton(m.number, mt.title) }}
      </li>
      {%- endif %}
      {% endfor %}
    </ul>

    {% for m in campaign.payments %}
    {% if m.type == "swift" %}
    {%- set mt = t.donate.methods[m.id] %}
    <details class="pay-swift" id="pay-{{ m.id }}">
      <summary>
        <span class="pay-row__currency">{{ m.currency }}</span>
        <span class="pay-swift__title">
          <span class="pay-row__title">{{ mt.title }}</span>
          <span class="pay-swift__toggle">{{ t.donate.swiftShow }}</span>
        </span>
      </summary>
      <div class="pay-swift__body">
        <p class="pay-swift__hint">{{ mt.hint }}</p>
        <dl class="pay__fields">
          {#- Fields appear in the order of t.donate.swiftFields; delete one from campaign.json to hide it -#}
          {% for key, label in t.donate.swiftFields %}
          {% if m[key] is defined %}
          <div>
            <dt>{{ label }}</dt>
            <dd>
              {% if m[key] | isTodo %}{% fill m[key] %}
              {% else %}<span class="pay__value">{{ m[key] }}</span>{% if key in ["beneficiary", "accountAmd", "accountUsd", "accountEur", "swift", "purpose"] %} {{ copyButton(m[key], label) }}{% endif %}
              {% endif %}
            </dd>
          </div>
          {% endif %}
          {% endfor %}
        </dl>
      </div>
    </details>
    {% endif %}
    {% endfor %}

    <p class="after-donate">{{ icon("heart") }} <span><strong>{{ t.donate.afterTitle }}{{ t.sep | trim }}</strong> {{ t.donate.after }}</span></p>
  </div>
</section>

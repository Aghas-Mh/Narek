{#- Inline SVG icons. Usage: {% from "partials/icons.njk" import icon %} … {{ icon("copy") }} -#}
{% macro icon(name, cls = "") -%}
<svg class="icon {{ cls }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "heart" -%}
<path fill="currentColor" stroke="none" d="M12 21.2 4.2 13.5a5.4 5.4 0 0 1 7.6-7.7l.2.2.2-.2a5.4 5.4 0 0 1 7.6 7.7Z"/>
{%- elif name == "calendar" -%}
<rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M16 2.5v4M8 2.5v4M3 10h18"/>
{%- elif name == "check-circle" -%}
<circle cx="12" cy="12" r="9.5"/><path d="m8 12.2 2.8 2.8L16.2 9.4"/>
{%- elif name == "clock" -%}
<circle cx="12" cy="12" r="9.5"/><path d="M12 7v5l3.2 2"/>
{%- elif name == "info" -%}
<circle cx="12" cy="12" r="9.5"/><path d="M12 16.5v-5M12 7.8h.01"/>
{%- elif name == "copy" -%}
<rect x="9" y="9" width="11.5" height="11.5" rx="2.2"/><path d="M5.5 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v.5"/>
{%- elif name == "check" -%}
<path d="M20 6.5 9.5 17 4 11.5"/>
{%- elif name == "share" -%}
<circle cx="18" cy="5" r="2.6"/><circle cx="6" cy="12" r="2.6"/><circle cx="18" cy="19" r="2.6"/><path d="m8.3 13.3 7.4 4.4M15.7 6.3 8.3 10.7"/>
{%- elif name == "link" -%}
<path d="M10 13.5a4.5 4.5 0 0 0 6.8.5l2.8-2.8a4.5 4.5 0 0 0-6.4-6.4l-1.4 1.4"/><path d="M14 10.5a4.5 4.5 0 0 0-6.8-.5l-2.8 2.8a4.5 4.5 0 0 0 6.4 6.4l1.4-1.4"/>
{%- elif name == "download" -%}
<path d="M12 3.5v11M7 10l5 5 5-5M4 17.5v1A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5v-1"/>
{%- elif name == "file" -%}
<path d="M14 2.5H6.5A2.5 2.5 0 0 0 4 5v14a2.5 2.5 0 0 0 2.5 2.5h11A2.5 2.5 0 0 0 20 19V8.5Z"/><path d="M14 2.5v6h6M8 13h8M8 17h5"/>
{%- elif name == "image" -%}
<rect x="3" y="3" width="18" height="18" rx="2.5"/><circle cx="8.5" cy="8.5" r="1.6"/><path d="m21 15.5-5-5L5 21"/>
{%- elif name == "play" -%}
<circle cx="12" cy="12" r="9.5"/><path d="m10 8.5 5.5 3.5-5.5 3.5Z"/>
{%- elif name == "close" -%}
<path d="M18 6 6 18M6 6l12 12"/>
{%- elif name == "arrow-right" -%}
<path d="M5 12h14M13 6l6 6-6 6"/>
{%- endif -%}
</svg>
{%- endmacro %}
